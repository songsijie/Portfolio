---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-[100%] mx-auto space-y-8 md:py-36 pb-14">
    <div class="hero-intro">
      <p class="hero-greeting">
        <span lang="en">Hi, I'm Dear Song.</span>
        <span lang="zh-CN">你好，小小？笑笑！</span>
      </p>
      <div class="hero-grid">
        <h1 class="hero-title">
          <span lang="en">Build things.<br />Stay curious.</span>
          <span class="hero-tagline" lang="zh-CN">动手创造，保持好奇。</span>
        </h1>
        <div class="hero-description">
          <p class="hero-copy-zh" lang="zh-CN">
            <span class="hero-role">一名<span class="text-[var(--sec)] shiny-sec">后端出身</span>的全栈开发者。</span>
            喜欢拆解问题、动手实现，也在不断探索代码之外的可能。
            这里记录我的技术笔记、开发实践，以及一些正在成形的想法。
          </p>
          <p class="hero-copy-en" lang="en">
            <span class="hero-role">A full-stack developer with roots in backend engineering.</span>
            I enjoy breaking down problems, bringing ideas to life, and exploring possibilities beyond code.
            This is where I share technical notes, hands-on work, and ideas taking shape.
          </p>
        </div>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          href="https://github.com/songsijie"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- 明确指定从右往左滚动 -->
    <LogoWall direction="right" />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <!-- <SkillsList client:load /> -->
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
    <!-- 从左往右滚动 -->
    <LogoWall direction="left" />
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>

<style>
  .hero-intro { padding-bottom: 20px; }
  .hero-greeting { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-bottom: 28px; font-size: 14px; line-height: 1.6; color: var(--white-icon); }
  .hero-greeting span:first-child { color: var(--white); }
  .hero-grid { display: grid; gap: 32px; }
  .hero-title { margin: 0; font-size: clamp(36px, 5vw, 72px); font-weight: 500; line-height: 1.08; letter-spacing: -0.045em; }
  .hero-tagline { display: block; margin-top: 20px; font-size: 16px; font-weight: 400; line-height: 1.6; letter-spacing: 0.1em; color: var(--white-icon); }
  .hero-description { max-width: 600px; align-self: center; }
  .hero-copy-zh { font-size: 17px; line-height: 1.9; color: var(--white-icon); text-wrap: pretty; }
  .hero-role { display: block; margin-bottom: 10px; }
  .hero-copy-zh .hero-role { color: var(--white); font-size: 19px; }
  .hero-copy-en { margin-top: 22px; padding-top: 20px; border-top: 1px solid #ffffff14; color: var(--white-icon); font-size: 14px; line-height: 1.8; text-wrap: pretty; }
  .hero-copy-en .hero-role { margin-bottom: 8px; }
  @media (min-width: 1100px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 5vw, 100px); }
    .hero-greeting { margin-bottom: 36px; }
  }
  @media (max-width: 480px) {
    .hero-greeting { font-size: 12px; margin-bottom: 22px; }
    .hero-copy-zh { font-size: 15px; }
    .hero-copy-zh .hero-role { font-size: 17px; }
    .hero-copy-en { font-size: 13px; }
  }
</style>
